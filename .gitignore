# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
**/__pycache__/
**/.pytest_cache/

# next.js
**/.next/
**/out/

# leftover pre-split working-tree paths (python/tests/build now live under software/)
/python/
/tests/
/build/

# generated icons / wizard bitmaps (keep installer scripts tracked)
/software/build/*
!/software/build/*.iss
!/software/build/*.nsh
!/software/build/*.txt
!/software/build/icon.png
!/software/build/icon.ico
!/software/build/icon.icns
!/software/build/icons/
!/software/build/icons/**

# electron desktop build output
**/dist_desktop/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# LLM weights — GitHub rejects files over 100MB
*.gguf
software/resources/ai/models/blobs/
