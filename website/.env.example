# Copy to website/.env.local (gitignored). Never commit real values.
# Public client values from Supabase → Project Settings → API.
# Do not put a service-role key, encryption key, password, or refresh token here.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local tester only. Keeps PKCE authorization codes in process memory.
# Do not use memory for a deployed website.
GAID_DESKTOP_AUTH_STORE=memory

# Required only if GAID_DESKTOP_AUTH_STORE is unset (writes desktop_auth_codes).
# Never put these in software/, Git, or the Linux package.
# SUPABASE_SERVICE_ROLE_KEY=
# DESKTOP_AUTH_TOKEN_KEY=
