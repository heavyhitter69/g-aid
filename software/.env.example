# Copy to software/.env.local (gitignored). Never commit real values.
# Use the same Supabase project as website/.env.local.
# These NEXT_PUBLIC_ values are publishable client config, not service-role secrets.
# Do not put a service-role key, encryption key, password, or refresh token here.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Packaged or unpackaged Electron must set this at launch for local PKCE.
# Use the website origin, not the software Next server on port 47821.
# GAID_AUTH_BASE_URL=http://127.0.0.1:3000
